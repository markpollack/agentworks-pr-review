{
  "apiVersion": "workflow/v3alpha",
  "kind": "Workflow",
  "metadata": {
    "name": "pr-review",
    "version": "1.0.0",
    "labels": {
      "app": "agentworks-pr-review"
    }
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pr": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "pr"
    ]
  },
  "operations": {
    "cleanup-branch": {
      "ref": "java:pr-review.cleanup-branch:v1"
    },
    "detect-conflicts": {
      "ref": "java:pr-review.detect-conflicts:v1"
    },
    "fetch-pr-context": {
      "ref": "java:pr-review.fetch-pr-context:v1"
    },
    "fix-and-retest": {
      "ref": "java:pr-review.fix-and-retest:v1"
    },
    "rebase-on-main": {
      "ref": "java:pr-review.rebase-on-main:v1"
    },
    "run-tests": {
      "ref": "java:pr-review.run-tests:v1"
    }
  },
  "nodes": [
    {
      "id": "fetch-pr-context",
      "kind": "operation",
      "operation": "fetch-pr-context",
      "input": {
        "pr": {
          "from": "$input.pr"
        }
      }
    },
    {
      "id": "rebase-on-main",
      "kind": "operation",
      "operation": "rebase-on-main",
      "input": {
        "context": {
          "from": "$node.fetch-pr-context.output"
        }
      }
    },
    {
      "id": "detect-conflicts",
      "kind": "operation",
      "operation": "detect-conflicts",
      "input": {
        "rebase": {
          "from": "$node.rebase-on-main.output"
        }
      }
    },
    {
      "id": "run-tests",
      "kind": "operation",
      "operation": "run-tests",
      "input": {
        "conflicts": {
          "from": "$node.detect-conflicts.output"
        }
      }
    },
    {
      "id": "fix-and-retest",
      "kind": "operation",
      "operation": "fix-and-retest",
      "input": {
        "build": {
          "from": "$node.run-tests.output"
        }
      }
    },
    {
      "id": "cleanup-branch",
      "kind": "operation",
      "operation": "cleanup-branch",
      "input": {
        "build": {
          "from": "$node.fix-and-retest.output"
        }
      }
    },
    {
      "id": "done",
      "kind": "terminate",
      "status": "completed",
      "result": {
        "from": "$node.cleanup-branch.output"
      }
    }
  ],
  "edges": [
    {
      "from": "fetch-pr-context",
      "to": "rebase-on-main",
      "when": {
        "kind": "always"
      }
    },
    {
      "from": "rebase-on-main",
      "to": "detect-conflicts",
      "when": {
        "kind": "always"
      }
    },
    {
      "from": "detect-conflicts",
      "to": "run-tests",
      "when": {
        "kind": "always"
      }
    },
    {
      "from": "run-tests",
      "to": "fix-and-retest",
      "when": {
        "kind": "always"
      }
    },
    {
      "from": "fix-and-retest",
      "to": "cleanup-branch",
      "when": {
        "kind": "always"
      }
    },
    {
      "from": "cleanup-branch",
      "to": "done",
      "when": {
        "kind": "always"
      }
    }
  ],
  "entrypoint": "fetch-pr-context",
  "outputs": {
    "result": {
      "from": "$node.cleanup-branch.output"
    }
  }
}
