{
  "apiVersion" : "workflow/v3alpha",
  "budget" : {
    "maxCostUsd" : 5,
    "maxDuration" : "PT30M"
  },
  "edges" : [ {
    "from" : "fetch-pr-context",
    "to" : "rebase-on-main",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "rebase-on-main",
    "to" : "detect-conflicts",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "detect-conflicts",
    "to" : "run-tests",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "run-tests",
    "to" : "should-attempt-fix",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "should-attempt-fix",
    "to" : "fix-tests",
    "when" : {
      "kind" : "decisionResult",
      "value" : "fix"
    }
  }, {
    "from" : "fix-tests",
    "to" : "retest",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "retest",
    "to" : "cleanup-branch",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "should-attempt-fix",
    "to" : "cleanup-branch",
    "when" : {
      "kind" : "decisionResult",
      "value" : "skip"
    }
  }, {
    "from" : "cleanup-branch",
    "to" : "build-health",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "build-health",
    "to" : "version-pattern-check",
    "when" : {
      "kind" : "verdict",
      "value" : "pass"
    }
  }, {
    "from" : "version-pattern-check",
    "to" : "assess",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "assess-join",
    "to" : "quality-judge",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "quality-judge",
    "to" : "assemble-report",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "assemble-report",
    "to" : "generate-report",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "generate-report",
    "to" : "published",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "build-health",
    "to" : "assemble-early-report",
    "when" : {
      "kind" : "verdict",
      "value" : "fail"
    }
  }, {
    "from" : "assemble-early-report",
    "to" : "generate-early-report",
    "when" : {
      "kind" : "always"
    }
  }, {
    "from" : "generate-early-report",
    "to" : "early-published",
    "when" : {
      "kind" : "always"
    }
  } ],
  "entrypoint" : "fetch-pr-context",
  "inputSchema" : {
    "additionalProperties" : false,
    "properties" : {
      "pr" : {
        "type" : "integer"
      }
    },
    "required" : [ "pr" ],
    "type" : "object"
  },
  "kind" : "Workflow",
  "metadata" : {
    "labels" : {
      "app" : "agentworks-pr-review"
    },
    "name" : "pr-review",
    "version" : "1.0.0"
  },
  "nodes" : [ {
    "id" : "fetch-pr-context",
    "input" : {
      "prRequest" : {
        "from" : "$input"
      }
    },
    "kind" : "operation",
    "operation" : "fetch-pr-context"
  }, {
    "id" : "rebase-on-main",
    "input" : {
      "prContext" : {
        "from" : "$node.fetch-pr-context.output"
      }
    },
    "kind" : "operation",
    "operation" : "rebase-on-main"
  }, {
    "id" : "detect-conflicts",
    "input" : {
      "rebaseResult" : {
        "from" : "$node.rebase-on-main.output"
      }
    },
    "kind" : "operation",
    "operation" : "detect-conflicts"
  }, {
    "contextWrites" : {
      "build.result" : {
        "from" : "$node.run-tests.output"
      }
    },
    "id" : "run-tests",
    "input" : {
      "conflicts" : {
        "from" : "$node.detect-conflicts.output"
      },
      "context" : {
        "from" : "$node.fetch-pr-context.output"
      }
    },
    "kind" : "operation",
    "operation" : "run-tests"
  }, {
    "config" : {
      "fixTestsEnabled" : false
    },
    "id" : "should-attempt-fix",
    "input" : {
      "build" : {
        "from" : "$node.run-tests.output"
      },
      "conflicts" : {
        "from" : "$node.detect-conflicts.output"
      },
      "rebase" : {
        "from" : "$node.rebase-on-main.output"
      }
    },
    "kind" : "decision",
    "operation" : "should-attempt-fix",
    "outcomes" : [ "fix", "skip" ]
  }, {
    "id" : "fix-tests",
    "input" : {
      "build" : {
        "from" : "$node.run-tests.output"
      },
      "context" : {
        "from" : "$node.fetch-pr-context.output"
      }
    },
    "kind" : "operation",
    "operation" : "fix-tests",
    "policies" : {
      "retry" : {
        "backoff" : {
          "initialMillis" : 5000,
          "multiplier" : 2,
          "strategy" : "exponential"
        },
        "maxAttempts" : 1
      }
    }
  }, {
    "contextWrites" : {
      "build.result" : {
        "from" : "$node.retest.output"
      }
    },
    "id" : "retest",
    "input" : {
      "conflicts" : {
        "from" : "$node.detect-conflicts.output"
      },
      "context" : {
        "from" : "$node.fetch-pr-context.output"
      }
    },
    "kind" : "operation",
    "operation" : "run-tests"
  }, {
    "id" : "cleanup-branch",
    "input" : {
      "prContext" : {
        "from" : "$node.fetch-pr-context.output"
      }
    },
    "kind" : "operation",
    "operation" : "cleanup-branch"
  }, {
    "id" : "build-health",
    "input" : {
      "buildResult" : {
        "from" : "$context.build.result"
      }
    },
    "judge" : {
      "jury" : "build-health-jury",
      "threshold" : 0.7
    },
    "kind" : "gate",
    "mode" : "judge"
  }, {
    "id" : "version-pattern-check",
    "input" : {
      "prContext" : {
        "from" : "$node.fetch-pr-context.output"
      }
    },
    "kind" : "operation",
    "operation" : "version-pattern-check"
  }, {
    "branches" : [ {
      "id" : "assess-code-quality",
      "input" : {
        "prContext" : {
          "from" : "$node.fetch-pr-context.output"
        }
      },
      "operation" : "assess-code-quality"
    }, {
      "id" : "assess-backport",
      "input" : {
        "prContext" : {
          "from" : "$node.fetch-pr-context.output"
        }
      },
      "operation" : "assess-backport"
    } ],
    "id" : "assess",
    "join" : "assess-join",
    "kind" : "parallel",
    "maxConcurrency" : 2
  }, {
    "id" : "assess-join",
    "kind" : "join",
    "mode" : "ENRICHMENT"
  }, {
    "id" : "quality-judge",
    "input" : {
      "input" : {
        "from" : "$node.assess-join.output"
      }
    },
    "kind" : "operation",
    "operation" : "quality-judge"
  }, {
    "id" : "assemble-report",
    "input" : {
      "build" : {
        "from" : "$context.build.result"
      },
      "conflicts" : {
        "from" : "$node.detect-conflicts.output"
      },
      "context" : {
        "from" : "$node.fetch-pr-context.output"
      },
      "quality" : {
        "from" : "$node.quality-judge.output"
      },
      "rebase" : {
        "from" : "$node.rebase-on-main.output"
      },
      "verdict" : {
        "from" : "$node.build-health.verdict"
      }
    },
    "kind" : "operation",
    "operation" : "assemble-report",
    "policies" : {
      "timeout" : {
        "perAttemptMillis" : 120000
      }
    }
  }, {
    "id" : "generate-report",
    "input" : {
      "reviewReport" : {
        "from" : "$node.assemble-report.output"
      }
    },
    "kind" : "operation",
    "operation" : "generate-report"
  }, {
    "id" : "published",
    "kind" : "terminate",
    "result" : {
      "from" : "$node.generate-report.output"
    },
    "status" : "completed"
  }, {
    "id" : "assemble-early-report",
    "input" : {
      "build" : {
        "from" : "$context.build.result"
      },
      "conflicts" : {
        "from" : "$node.detect-conflicts.output"
      },
      "context" : {
        "from" : "$node.fetch-pr-context.output"
      },
      "rebase" : {
        "from" : "$node.rebase-on-main.output"
      },
      "verdict" : {
        "from" : "$node.build-health.verdict"
      }
    },
    "kind" : "operation",
    "operation" : "assemble-early-report",
    "policies" : {
      "timeout" : {
        "perAttemptMillis" : 120000
      }
    }
  }, {
    "id" : "generate-early-report",
    "input" : {
      "reviewReport" : {
        "from" : "$node.assemble-early-report.output"
      }
    },
    "kind" : "operation",
    "operation" : "generate-report"
  }, {
    "id" : "early-published",
    "kind" : "terminate",
    "result" : {
      "from" : "$node.generate-early-report.output"
    },
    "status" : "completed"
  } ],
  "outputSchema" : {
    "type" : "string"
  },
  "policies" : {
    "retry" : {
      "backoff" : {
        "initialMillis" : 1000,
        "multiplier" : 2,
        "strategy" : "exponential"
      },
      "maxAttempts" : 2
    }
  },
  "providers" : {
    "assemble-early-report" : {
      "contract" : {
        "name" : "pr-review.assemble-early-report",
        "version" : 1
      }
    },
    "assemble-report" : {
      "contract" : {
        "name" : "pr-review.assemble-report",
        "version" : 1
      }
    },
    "assess-backport" : {
      "contract" : {
        "name" : "pr-review.assess-backport",
        "version" : 1
      }
    },
    "assess-code-quality" : {
      "contract" : {
        "name" : "pr-review.assess-code-quality",
        "version" : 1
      }
    },
    "build-health-jury" : {
      "contract" : {
        "name" : "pr-review.build-health-jury",
        "version" : 1
      }
    },
    "cleanup-branch" : {
      "contract" : {
        "name" : "pr-review.cleanup-branch",
        "version" : 1
      }
    },
    "detect-conflicts" : {
      "contract" : {
        "name" : "pr-review.detect-conflicts",
        "version" : 1
      }
    },
    "fetch-pr-context" : {
      "contract" : {
        "name" : "pr-review.fetch-pr-context",
        "version" : 1
      }
    },
    "fix-tests" : {
      "contract" : {
        "name" : "pr-review.fix-tests",
        "version" : 1
      }
    },
    "generate-report" : {
      "contract" : {
        "name" : "pr-review.generate-report",
        "version" : 1
      }
    },
    "quality-judge" : {
      "contract" : {
        "name" : "pr-review.quality-judge",
        "version" : 1
      }
    },
    "rebase-on-main" : {
      "contract" : {
        "name" : "pr-review.rebase-on-main",
        "version" : 1
      }
    },
    "run-tests" : {
      "contract" : {
        "name" : "pr-review.run-tests",
        "version" : 1
      },
      "defaultPolicies" : {
        "timeout" : {
          "perAttemptMillis" : 600000
        }
      }
    },
    "should-attempt-fix" : {
      "contract" : {
        "name" : "pr-review.should-attempt-fix",
        "version" : 1
      }
    },
    "version-pattern-check" : {
      "contract" : {
        "name" : "pr-review.version-pattern-check",
        "version" : 1
      }
    }
  }
}
